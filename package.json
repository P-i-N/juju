{
  "name": "juju",
  "displayName": "Juju",
  "publisher": "juju",
  "description": "First-class VS Code integration for Jujutsu (jj) with visual history and fluid workflows",
  "icon": "images/logo.png",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/P-i-N/juju.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/main.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "type": "webview",
          "id": "jujuGraphWebview",
          "name": "JJ Graph",
          "when": "juju.reposExist"
        },
        {
          "id": "jujuOperationLog",
          "name": "JJ Operation Log",
          "when": "juju.reposExist"
        }
      ]
    },
    "commands": [
      {
        "command": "juju.refresh",
        "title": "Refresh",
        "category": "Jujutsu",
        "icon": "$(refresh)",
        "enablement": "!operationInProgress"
      },
      {
        "command": "juju.openFileResourceState",
        "title": "Open File",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "juju.openFileAtRevision",
        "title": "Open File",
        "category": "Jujutsu",
        "icon": "$(eye)"
      },
      {
        "command": "juju.toggleDiffView",
        "title": "Toggle Diff View",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "juju.openDiffResourceState",
        "title": "View as Diff",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "juju.openFileInWorkingCopyEditor",
        "title": "Open File in Working Copy",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "juju.openFileInWorkingCopyResourceState",
        "title": "Open File in Working Copy",
        "category": "Jujutsu",
        "icon": "$(go-to-file)"
      },
      {
        "command": "juju.describe",
        "title": "Update Change Description",
        "category": "Jujutsu",
        "icon": "$(edit)"
      },
      {
        "command": "juju.new",
        "title": "Create New Change",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "juju.newWithEditor",
        "title": "Create New Change with Editor",
        "category": "Jujutsu"
      },
      {
        "command": "juju.squashToParentResourceGroup",
        "title": "Move Changes to Parent",
        "category": "Jujutsu",
        "icon": "$(arrow-down)"
      },
      {
        "command": "juju.squashToWorkingCopyResourceGroup",
        "title": "Move Changes to Working Copy",
        "category": "Jujutsu",
        "icon": "$(arrow-up)"
      },
      {
        "command": "juju.squashToParentResourceState",
        "title": "Move Changes to Parent",
        "category": "Jujutsu",
        "icon": "$(arrow-down)"
      },
      {
        "command": "juju.squashToWorkingCopyResourceState",
        "title": "Move Changes to Working Copy",
        "category": "Jujutsu",
        "icon": "$(arrow-up)"
      },
      {
        "command": "juju.editResourceGroup",
        "title": "Edit This Change",
        "category": "Jujutsu",
        "icon": "$(sign-in)"
      },
      {
        "command": "juju.viewInterdiff",
        "title": "View Interdiff",
        "category": "Jujutsu",
        "icon": "$(compare-changes)"
      },
      {
        "command": "juju.viewRegularDiff",
        "title": "View Regular Diff",
        "category": "Jujutsu",
        "icon": "$(diff)"
      },
      {
        "command": "juju.restoreResourceState",
        "title": "Discard Changes",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "juju.restoreResourceGroup",
        "title": "Discard Changes",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "juju.gitFetch",
        "title": "Fetch from Default Remote",
        "category": "Jujutsu",
        "icon": "$(cloud-download)"
      },
      {
        "command": "juju.gitFetch.syncing",
        "title": "Fetching from Default Remote... (Click to Cancel)",
        "category": "Jujutsu",
        "icon": "$(sync~spin)"
      },
      {
        "command": "juju.refreshOperationLog",
        "title": "Refresh Operation Log",
        "category": "Jujutsu",
        "icon": "$(refresh)"
      },
      {
        "command": "juju.selectOperationLogRepo",
        "title": "Select Repository",
        "category": "Jujutsu",
        "icon": "$(repo)"
      },
      {
        "command": "juju.undo",
        "title": "Undo",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "juju.redo",
        "title": "Redo",
        "category": "Jujutsu",
        "icon": "$(redo)"
      },
      {
        "command": "juju.operationRevert",
        "title": "Revert Operation",
        "category": "Jujutsu",
        "icon": "$(discard)"
      },
      {
        "command": "juju.operationRestore",
        "title": "Restore Repo to the State at This Operation",
        "category": "Jujutsu",
        "icon": "$(history)"
      },
      {
        "command": "juju.refreshGraphWebview",
        "title": "Refresh JJ Graph",
        "category": "Jujutsu",
        "icon": "$(refresh)"
      },
      {
        "command": "juju.openDetailsWebview",
        "title": "Show Details of Selected Change",
        "category": "Jujutsu",
        "icon": "$(info)"
      },
      {
        "command": "juju.openGraphInTab",
        "title": "Open Graph in Tab",
        "category": "Jujutsu",
        "icon": "$(link-external)"
      },
      {
        "command": "juju.toggleElideImmutableCommits.show",
        "title": "Show Elided Commits",
        "category": "Jujutsu",
        "icon": "$(unfold)"
      },
      {
        "command": "juju.toggleElideImmutableCommits.elide",
        "title": "Elide Immutable Commits",
        "category": "Jujutsu",
        "icon": "$(fold)"
      },
      {
        "command": "juju.newGraphWebview",
        "title": "Create New Change with Selected as Parents",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "juju.selectGraphWebviewRepo",
        "title": "Select Repository",
        "category": "Jujutsu",
        "icon": "$(repo)"
      },
      {
        "command": "juju.placeholderForFolders",
        "title": "​",
        "category": "Jujutsu",
        "enablement": "false"
      },
      {
        "command": "juju.squashSelectedRanges",
        "title": "Squash Selected Changes...",
        "category": "Jujutsu"
      },
      {
        "command": "juju.openParentChange",
        "title": "Open Parent Change",
        "category": "Jujutsu",
        "icon": "$(arrow-left)"
      },
      {
        "command": "juju.openChildChange",
        "title": "Open Child Change",
        "category": "Jujutsu",
        "icon": "$(arrow-right)"
      },
      {
        "command": "juju.copyPath",
        "title": "Copy Path",
        "category": "Jujutsu"
      },
      {
        "command": "juju.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Jujutsu"
      },
      {
        "command": "juju.trackUntrackedFile",
        "title": "Track This File",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "juju.deleteUntrackedFile",
        "title": "Delete This File",
        "category": "Jujutsu",
        "icon": "$(trash)"
      },
      {
        "command": "juju.trackAllUntrackedFiles",
        "title": "Track All Untracked Files",
        "category": "Jujutsu",
        "icon": "$(plus)"
      },
      {
        "command": "juju.deleteAllUntrackedFiles",
        "title": "Delete All Untracked Files",
        "category": "Jujutsu",
        "icon": "$(trash)"
      },
      {
        "command": "juju.gitFetchAllRemotes",
        "title": "Fetch from All Remotes",
        "category": "Jujutsu",
        "icon": "$(cloud-download)"
      },
      {
        "command": "juju.gitFetchFromRemote",
        "title": "Fetch from Selected Remote...",
        "category": "Jujutsu",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "juju.gitPushToRemote",
        "title": "Push to Selected Remote...",
        "category": "Jujutsu",
        "icon": "$(repo-push)"
      },
      {
        "command": "juju.graphFetchSubmenu.fetchAllRemotes",
        "title": "Fetch from All Remotes",
        "category": "Jujutsu",
        "icon": "$(cloud-download)"
      },
      {
        "command": "juju.graphFetchSubmenu.fetchFromRemote",
        "title": "Fetch from Selected Remote...",
        "category": "Jujutsu",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "juju.graphFetchSubmenu.pushToRemote",
        "title": "Push to Selected Remote...",
        "category": "Jujutsu",
        "icon": "$(repo-push)"
      },
      {
        "command": "juju.graphFetchSubmenu.syncing",
        "title": "Fetch & Push in Progress... (Click to Cancel)",
        "category": "Jujutsu",
        "icon": "$(sync~spin)"
      }
    ],
    "submenus": [
      {
        "id": "juju.graphFetchSubmenu",
        "label": "Fetch & Push...",
        "icon": "$(cloud)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "juju.squashSelectedRanges",
          "when": "juju.reposExist && editorTextFocus && editorHasSelection && !editorReadonly"
        },
        {
          "command": "juju.toggleDiffView",
          "when": "juju.reposExist && !juju.comparisonDiffActive && !juju.diffModifiedDeleted && activeWebviewPanelId != 'jujuGraphTab'",
          "group": "navigation@1"
        },
        {
          "command": "juju.openFileInWorkingCopyEditor",
          "when": "juju.reposExist && resourceScheme == juju",
          "group": "navigation@2"
        },
        {
          "command": "juju.openParentChange",
          "when": "juju.reposExist && !juju.comparisonDiffActive && activeWebviewPanelId != 'jujuGraphTab'",
          "group": "navigation@2"
        },
        {
          "command": "juju.openChildChange",
          "when": "juju.reposExist && !juju.comparisonDiffActive && activeWebviewPanelId != 'jujuGraphTab'",
          "group": "navigation@3"
        },
        {
          "command": "juju.openDetailsWebview",
          "when": "activeWebviewPanelId == 'jujuGraphTab'",
          "group": "navigation@0"
        },
        {
          "command": "juju.gitFetch",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && !juju.fetching",
          "group": "navigation@1"
        },
        {
          "command": "juju.gitFetch.syncing",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && juju.fetching",
          "group": "navigation@1"
        },
        {
          "submenu": "juju.graphFetchSubmenu",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && !juju.fetchPushSyncing",
          "group": "navigation@2"
        },
        {
          "command": "juju.graphFetchSubmenu.syncing",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && juju.fetchPushSyncing",
          "group": "navigation@2"
        },
        {
          "command": "juju.undo",
          "when": "activeWebviewPanelId == 'jujuGraphTab'",
          "group": "navigation@3"
        },
        {
          "command": "juju.redo",
          "when": "activeWebviewPanelId == 'jujuGraphTab'",
          "group": "navigation@4"
        },
        {
          "command": "juju.refreshGraphWebview",
          "when": "activeWebviewPanelId == 'jujuGraphTab'",
          "group": "navigation@5"
        },
        {
          "command": "juju.newGraphWebview",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && jujuGraphView.nodesSelected",
          "group": "navigation@6"
        },
        {
          "command": "juju.toggleElideImmutableCommits.show",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && jujuGraphView.elidingActive",
          "group": "navigation@7"
        },
        {
          "command": "juju.toggleElideImmutableCommits.elide",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && !jujuGraphView.elidingActive",
          "group": "navigation@7"
        },
        {
          "command": "juju.selectGraphWebviewRepo",
          "when": "activeWebviewPanelId == 'jujuGraphTab' && juju.hasMultipleRepos",
          "group": "navigation@8"
        }
      ],
      "editor/context": [
        {
          "command": "juju.squashSelectedRanges",
          "when": "juju.reposExist && editorTextFocus && editorHasSelection && !editorReadonly"
        }
      ],
      "view/title": [
        {
          "command": "juju.undo",
          "when": "view == jujuOperationLog",
          "group": "navigation@1"
        },
        {
          "command": "juju.redo",
          "when": "view == jujuOperationLog",
          "group": "navigation@2"
        },
        {
          "command": "juju.refreshOperationLog",
          "when": "view == jujuOperationLog",
          "group": "navigation@3"
        },
        {
          "command": "juju.selectOperationLogRepo",
          "when": "view == jujuOperationLog && juju.hasMultipleRepos",
          "group": "navigation@4"
        },
        {
          "command": "juju.openDetailsWebview",
          "when": "view == jujuGraphWebview",
          "group": "navigation@0"
        },
        {
          "command": "juju.gitFetch",
          "when": "view == jujuGraphWebview && !juju.fetching",
          "group": "navigation@1"
        },
        {
          "command": "juju.gitFetch.syncing",
          "when": "view == jujuGraphWebview && juju.fetching",
          "group": "navigation@1"
        },
        {
          "submenu": "juju.graphFetchSubmenu",
          "when": "view == jujuGraphWebview && !juju.fetchPushSyncing",
          "group": "navigation@2"
        },
        {
          "command": "juju.graphFetchSubmenu.syncing",
          "when": "view == jujuGraphWebview && juju.fetchPushSyncing",
          "group": "navigation@2"
        },
        {
          "command": "juju.undo",
          "when": "view == jujuGraphWebview",
          "group": "navigation@3"
        },
        {
          "command": "juju.redo",
          "when": "view == jujuGraphWebview",
          "group": "navigation@4"
        },
        {
          "command": "juju.refreshGraphWebview",
          "when": "view == jujuGraphWebview",
          "group": "navigation@5"
        },
        {
          "command": "juju.newGraphWebview",
          "when": "view == jujuGraphWebview && jujuGraphView.nodesSelected",
          "group": "navigation@6"
        },
        {
          "command": "juju.toggleElideImmutableCommits.show",
          "when": "view == jujuGraphWebview && jujuGraphView.elidingActive",
          "group": "navigation@7"
        },
        {
          "command": "juju.toggleElideImmutableCommits.elide",
          "when": "view == jujuGraphWebview && !jujuGraphView.elidingActive",
          "group": "navigation@7"
        },
        {
          "command": "juju.selectGraphWebviewRepo",
          "when": "view == jujuGraphWebview && juju.hasMultipleRepos",
          "group": "navigation@8"
        },
        {
          "command": "juju.openGraphInTab",
          "when": "view == jujuGraphWebview",
          "group": "navigation@9"
        }
      ],
      "juju.graphFetchSubmenu": [
        {
          "command": "juju.graphFetchSubmenu.fetchAllRemotes",
          "when": "view == jujuGraphWebview || activeWebviewPanelId == 'jujuGraphTab'",
          "group": "1_fetch@1"
        },
        {
          "command": "juju.graphFetchSubmenu.fetchFromRemote",
          "when": "view == jujuGraphWebview || activeWebviewPanelId == 'jujuGraphTab'",
          "group": "1_fetch@2"
        },
        {
          "command": "juju.graphFetchSubmenu.pushToRemote",
          "when": "view == jujuGraphWebview || activeWebviewPanelId == 'jujuGraphTab'",
          "group": "2_push@1"
        }
      ],
      "view/item/context": [
        {
          "command": "juju.operationRevert",
          "when": "view == jujuOperationLog",
          "group": "inline"
        },
        {
          "command": "juju.operationRestore",
          "when": "view == jujuOperationLog",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "juju.refresh",
          "when": "scmProvider == juju && juju.jjBinaryFound",
          "group": "navigation"
        },
        {
          "command": "juju.new",
          "when": "scmProvider == juju && juju.jjBinaryFound",
          "group": "navigation"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "juju.squashToParentResourceGroup",
          "when": "scmProvider == juju && scmResourceGroup == @ && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.squashToWorkingCopyResourceGroup",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.restoreResourceGroup",
          "when": "scmProvider == juju && scmResourceGroup != selected && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.editResourceGroup",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.describe",
          "when": "scmProvider == juju && scmResourceGroup != diff && scmResourceGroup != interdiff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.viewInterdiff",
          "when": "scmProvider == juju && scmResourceGroup == diff && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.viewRegularDiff",
          "when": "scmProvider == juju && scmResourceGroup == interdiff && juju.jjBinaryFound",
          "group": "inline"
        },
        {
          "command": "juju.trackAllUntrackedFiles",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "juju.deleteAllUntrackedFiles",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "inline@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "juju.openDiffResourceState",
          "when": "scmProvider == juju && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "1_modification@1"
        },
        {
          "command": "juju.openFileAtRevision",
          "when": "scmProvider == juju && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && (scmResourceGroup == @ || scmResourceState != 'status-d') && juju.jjBinaryFound",
          "group": "1_modification@2"
        },
        {
          "command": "juju.openFileInWorkingCopyResourceState",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "1_modification@3"
        },
        {
          "command": "juju.copyPath",
          "when": "scmProvider == juju && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "9_copypath@1"
        },
        {
          "command": "juju.copyRelativePath",
          "when": "scmProvider == juju && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "9_copypath@2"
        },
        {
          "command": "juju.openFileResourceState",
          "when": "scmProvider == juju && scmResourceGroup == @ && config.juju.fileClickAction == 'diff' && juju.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "juju.openDiffResourceState",
          "when": "scmProvider == juju && scmResourceGroup == @ && config.juju.fileClickAction != 'diff' && juju.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "juju.openDiffResourceState",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && config.juju.fileClickAction != 'diff' && juju.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "juju.openFileAtRevision",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && scmResourceState != 'status-d' && config.juju.fileClickAction != 'at-revision' && juju.jjBinaryFound",
          "group": "inline@2"
        },
        {
          "command": "juju.openFileInWorkingCopyResourceState",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && config.juju.fileClickAction != 'working-copy' && juju.jjBinaryFound",
          "group": "inline@3"
        },
        {
          "command": "juju.restoreResourceState",
          "when": "scmProvider == juju && scmResourceGroup != selected && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline@4"
        },
        {
          "command": "juju.squashToParentResourceState",
          "when": "scmProvider == juju && scmResourceGroup == @ && juju.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "juju.squashToWorkingCopyResourceState",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != interdiff && scmResourceGroup != diff && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "juju.openFileInWorkingCopyResourceState",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "1_modification@1"
        },
        {
          "command": "juju.copyPath",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "9_copypath@1"
        },
        {
          "command": "juju.copyRelativePath",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "9_copypath@2"
        },
        {
          "command": "juju.trackUntrackedFile",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "inline@1"
        },
        {
          "command": "juju.deleteUntrackedFile",
          "when": "scmProvider == juju && scmResourceGroup == untracked && juju.jjBinaryFound",
          "group": "inline@2"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "command": "juju.restoreResourceState",
          "when": "scmProvider == juju && scmResourceGroup != selected && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline@4"
        },
        {
          "command": "juju.squashToParentResourceState",
          "when": "scmProvider == juju && scmResourceGroup == @ && juju.jjBinaryFound",
          "group": "inline@5"
        },
        {
          "command": "juju.squashToWorkingCopyResourceState",
          "when": "scmProvider == juju && scmResourceGroup != @ && scmResourceGroup != selected && scmResourceGroup != untracked && juju.jjBinaryFound",
          "group": "inline@5"
        }
      ],
      "commandPalette": [
