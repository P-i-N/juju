          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "languages": [
      {
        "id": "jj-commit",
        "aliases": [
          "JJ Commit Message",
          "jj-commit"
        ],
        "extensions": [
          ".jjdescription"
        ],
        "configuration": "./languages/jj-commit.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jj-commit",
        "scopeName": "text.jj-commit",
        "path": "./syntaxes/jj-commit.tmLanguage.json"
      }
    ]
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "build-dev": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:tsc:webview": "tsc --noEmit --watch --project src/webview/tsconfig.json",
    "watch:css-types": "tcm -w -s -o src/webview/graph/.generated src/webview/graph",
    "gen-css-types": "tcm -s -o src/webview/graph/.generated src/webview/graph",
    "check-types": "pnpm run gen-css-types && tsc --noEmit && tsc --noEmit --project src/webview/tsconfig.json && tsc --noEmit --project tests-integration/tsconfig.json",
    "lint": "eslint esbuild.js src tests-integration/*.ts tests-integration/tests",
    "format": "prettier --write . | { grep -v '(unchanged)$'; true; }",
    "format:check": "prettier --check --log-level warn .",
    "check": "npm-run-all check-types lint format:check unit-test",
    "unit-test": "node --import tsx --test --test-reporter ./src/unit-test/reporter.mjs src/unit-test/*.test.ts",
    "test": "npm-run-all unit-test playwright-test",
    "playwright-test": "pnpm run build && pnpm exec playwright test --config=tests-integration/playwright.config.ts",
    "playwright-test:only-test": "pnpm exec playwright test --config=tests-integration/playwright.config.ts",
    "update-animations": "pnpm run build && pnpm exec playwright test --config=tests-integration/screenshot/animations.config.ts",
    "package": "pnpm exec vsce package --no-dependencies --allow-star-activation",
    "publish": "pnpm exec vsce publish --no-dependencies --allow-star-activation"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.125.0",
    "@types/which": "^3.0.4",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typed-css-modules": "^0.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@vscode/codicons": "0.0.46-24",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "preact": "^10.29.8",
    "which": "^7.0.0"
  }
