    "keybindings": [
      {
        "command": "juju.newWithEditor",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "scmRepository"
      }
    ],
    "configuration": {
      "title": "Juju",
      "properties": {
        "juju.autoSwitchRepository": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch the repository shown in the JJ Graph and Operation Log views to the repository containing the active editor.",
          "scope": "resource"
        },
        "juju.enableAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Enables in-line blame annotations",
          "scope": "resource"
        },
        "juju.commandTimeout": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Global timeout in milliseconds for all jj commands. If not set, per-command defaults will be used.",
          "scope": "resource",
          "minimum": 1000
        },
        "juju.jjPath": {
          "type": "string",
          "default": "",
          "description": "Path to the jj executable. If not set, your PATH and common locations will be searched for a jj executable.",
          "scope": "resource"
        },
        "juju.changeDoubleClickAction": {
          "type": "string",
          "default": "newEditUndescribed",
          "enum": [
            "edit",
            "new",
            "newEditUndescribed"
          ],
          "enumItemLabels": [
            "edit",
            "new",
            "new, edit undescribed"
          ],
          "enumDescriptions": [
            "Edits the change (jj edit)",
            "Creates an empty change on top and switches to it (jj new)",
            "Edits a change without a description (jj edit), and creates an empty change on top of a described change and switches to it (jj new)"
          ],
          "description": "Action to perform when double-clicking a change in the graph view",
          "scope": "resource"
        },
        "juju.commitAction": {
          "type": "string",
          "default": "commit",
          "enum": [
            "commit",
            "new"
          ],
          "enumDescriptions": [
            "Commits the current change with the description (jj commit)",
            "Creates a new change on top with the description (jj new)"
          ],
          "description": "Action to perform when pressing Ctrl+Enter in the source control input box",
          "scope": "resource"
        },
        "juju.graphStyle": {
          "type": "string",
          "default": "compact",
          "enum": [
            "full",
            "compact"
          ],
          "enumDescriptions": [
            "Show full commit details: description, change ID, commit ID, author, and timestamp",
            "Show compact single line: change ID - first line of description - author email"
          ],
          "description": "Display style for commits in the graph view",
          "scope": "resource"
        },
        "juju.pollIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds between repository polls. Set to 0 to disable polling.",
          "scope": "resource",
          "minimum": 0
        },
        "juju.fileClickAction": {
          "type": "string",
          "default": "diff",
          "enum": [
            "diff",
            "at-revision",
            "working-copy"
          ],
          "enumDescriptions": [
            "View the diff (comparing to parent)",
            "Open the file at the clicked revision",
            "Open the file in the working copy"
          ],
          "description": "Action when clicking a file in the change view",
          "scope": "resource"
        },
        "juju.elideImmutableCommits": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, chains of immutable commits between relevant commits are elided (hidden) in the graph view. When disabled, all commits are shown.",
          "scope": "resource"
        },
        "juju.elidedVisibleImmutableParents": {
          "type": "number",
          "default": 1,
          "description": "Number of immutable parent commits to show in the log when eliding commits.",
          "scope": "resource",
          "minimum": 0
        },
        "juju.logLimit": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of commits shown in the graph view. Smaller values improve performance, higher values show more history.",
          "scope": "resource",
          "minimum": 1
        },
        "juju.baseWebURL": {
          "type": "string",
          "default": "",
          "description": "Base URL for the 'Copy URL' feature. When set, this overrides git_web_url() for generating commit URLs (e.g., 'https://github.com/user/repo'). If empty, git_web_url() is used.",
          "scope": "resource"
        },
        "juju.showTooltips": {
          "type": "boolean",
          "default": true,
          "description": "Show tooltips when hovering over commits in the graph view",
          "scope": "resource"
        },
        "juju.autoUpdateStaleWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run 'jj workspace update-stale' when the working copy is stale",
          "scope": "resource"
        },
        "juju.showChangedFiles": {
          "type": "boolean",
          "default": true,
          "description": "⚠️ Experimental: Show an expandable list of changed files for each commit in the graph (similar to `jj log -s`). Click the arrow next to a commit (or press Right/Left on the selection) to expand or collapse its files. Clicking a file opens a diff at that revision; dragging it onto another change moves its changes there.",
          "scope": "resource"
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.jj": true
      }
    },
    "colors": [
      {
        "id": "jujuDecoration.addedResourceForeground",
